MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=career_mentor
# Only needed for managed MySQL providers that require TLS (Aiven, PlanetScale,
# RDS, ...) — path to the CA certificate they give you. Leave unset for local MySQL.
# MYSQL_SSL_CA=
LLM_PROVIDER=gemini
LLM_API_KEY=
# Only used when LLM_PROVIDER=gemini — defaults to gemini-1.5-flash if unset
# GEMINI_MODEL=gemini-1.5-flash
# Only used when LLM_PROVIDER=ollama — defaults shown, uncomment to override
# OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
# Comma-separated emails to auto-promote to admin (career management) on
# their next login/signup. Leave empty if you don't need an admin dashboard.
ADMIN_EMAILS=
