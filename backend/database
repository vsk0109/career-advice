-- ============================================================
-- AI CAREER MENTOR - MYSQL DATABASE
-- Database: career_mentor
-- ============================================================

DROP DATABASE IF EXISTS career_mentor;
CREATE DATABASE career_mentor;
USE career_mentor;

-- ============================================================
-- 1. STUDENTS
-- ============================================================
CREATE TABLE students (
    student_id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    email VARCHAR(150) UNIQUE,
    age INT,
    gender VARCHAR(20),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ============================================================
-- 2. STUDENT INTERESTS
-- ============================================================
CREATE TABLE student_interests (
    interest_id INT AUTO_INCREMENT PRIMARY KEY,
    student_id INT NOT NULL,
    interest VARCHAR(100) NOT NULL,
    FOREIGN KEY (student_id) REFERENCES students(student_id)
        ON DELETE CASCADE
);

-- ============================================================
-- 3. STUDENT HOBBIES
-- ============================================================
CREATE TABLE student_hobbies (
    hobby_id INT AUTO_INCREMENT PRIMARY KEY,
    student_id INT NOT NULL,
    hobby VARCHAR(100) NOT NULL,
    FOREIGN KEY (student_id) REFERENCES students(student_id)
        ON DELETE CASCADE
);

-- ============================================================
-- 4. STUDENT ACADEMICS
-- ============================================================
CREATE TABLE student_academics (
    academic_id INT AUTO_INCREMENT PRIMARY KEY,
    student_id INT NOT NULL,
    subject VARCHAR(100) NOT NULL,
    marks DECIMAL(5,2),
    FOREIGN KEY (student_id) REFERENCES students(student_id)
        ON DELETE CASCADE
);

-- ============================================================
-- 5. STUDENT RIASEC PROFILE
-- ============================================================
CREATE TABLE student_riasec (
    riasec_id INT AUTO_INCREMENT PRIMARY KEY,
    student_id INT NOT NULL UNIQUE,
    realistic_score DECIMAL(5,2) DEFAULT 0,
    investigative_score DECIMAL(5,2) DEFAULT 0,
    artistic_score DECIMAL(5,2) DEFAULT 0,
    social_score DECIMAL(5,2) DEFAULT 0,
    enterprising_score DECIMAL(5,2) DEFAULT 0,
    conventional_score DECIMAL(5,2) DEFAULT 0,
    FOREIGN KEY (student_id) REFERENCES students(student_id)
        ON DELETE CASCADE
);

-- ============================================================
-- 6. STUDENT SKILLS
-- ============================================================
CREATE TABLE student_skills (
    student_skill_id INT AUTO_INCREMENT PRIMARY KEY,
    student_id INT NOT NULL,
    skill_name VARCHAR(100) NOT NULL,
    skill_level INT CHECK (skill_level BETWEEN 1 AND 5),
    FOREIGN KEY (student_id) REFERENCES students(student_id)
        ON DELETE CASCADE
);

-- ============================================================
-- 7. CAREERS
-- ============================================================
CREATE TABLE careers (
    career_id INT AUTO_INCREMENT PRIMARY KEY,
    career_name VARCHAR(150) NOT NULL,
    description TEXT,
    realistic_score DECIMAL(5,2) DEFAULT 0,
    investigative_score DECIMAL(5,2) DEFAULT 0,
    artistic_score DECIMAL(5,2) DEFAULT 0,
    social_score DECIMAL(5,2) DEFAULT 0,
    enterprising_score DECIMAL(5,2) DEFAULT 0,
    conventional_score DECIMAL(5,2) DEFAULT 0
);

-- ============================================================
-- 8. CAREER SKILLS
-- ============================================================
CREATE TABLE career_skills (
    career_skill_id INT AUTO_INCREMENT PRIMARY KEY,
    career_id INT NOT NULL,
    skill_name VARCHAR(100) NOT NULL,
    required_level INT CHECK (required_level BETWEEN 1 AND 5),
    FOREIGN KEY (career_id) REFERENCES careers(career_id)
        ON DELETE CASCADE
);

-- ============================================================
-- 9. CAREER SUBJECTS
-- ============================================================
CREATE TABLE career_subjects (
    career_subject_id INT AUTO_INCREMENT PRIMARY KEY,
    career_id INT NOT NULL,
    subject VARCHAR(100) NOT NULL,
    FOREIGN KEY (career_id) REFERENCES careers(career_id)
        ON DELETE CASCADE
);

-- ============================================================
-- 10. COURSES
-- ============================================================
CREATE TABLE courses (
    course_id INT AUTO_INCREMENT PRIMARY KEY,
    course_name VARCHAR(150) NOT NULL,
    level VARCHAR(50),
    description TEXT
);

-- ============================================================
-- 11. CAREER <-> COURSE
-- ============================================================
CREATE TABLE career_courses (
    career_id INT NOT NULL,
    course_id INT NOT NULL,
    PRIMARY KEY (career_id, course_id),
    FOREIGN KEY (career_id) REFERENCES careers(career_id)
        ON DELETE CASCADE,
    FOREIGN KEY (course_id) REFERENCES courses(course_id)
        ON DELETE CASCADE
);

-- ============================================================
-- 12. UNIVERSITIES
-- ============================================================
CREATE TABLE universities (
    university_id INT AUTO_INCREMENT PRIMARY KEY,
    university_name VARCHAR(200) NOT NULL,
    location VARCHAR(200),
    website VARCHAR(300)
);

-- ============================================================
-- 13. COURSE <-> UNIVERSITY
-- ============================================================
CREATE TABLE course_universities (
    course_id INT NOT NULL,
    university_id INT NOT NULL,
    PRIMARY KEY (course_id, university_id),
    FOREIGN KEY (course_id) REFERENCES courses(course_id)
        ON DELETE CASCADE,
    FOREIGN KEY (university_id) REFERENCES universities(university_id)
        ON DELETE CASCADE
);

-- ============================================================
-- 14. SCHOLARSHIPS
-- ============================================================
CREATE TABLE scholarships (
    scholarship_id INT AUTO_INCREMENT PRIMARY KEY,
    scholarship_name VARCHAR(200) NOT NULL,
    provider VARCHAR(200),
    description TEXT,
    eligibility TEXT,
    amount VARCHAR(100),
    application_url VARCHAR(500)
);

-- ============================================================
-- 15. CAREER <-> SCHOLARSHIP
-- ============================================================
CREATE TABLE career_scholarships (
    career_id INT NOT NULL,
    scholarship_id INT NOT NULL,
    PRIMARY KEY (career_id, scholarship_id),
    FOREIGN KEY (career_id) REFERENCES careers(career_id)
        ON DELETE CASCADE,
    FOREIGN KEY (scholarship_id) REFERENCES scholarships(scholarship_id)
        ON DELETE CASCADE
);

-- ============================================================
-- 16. CAREER RECOMMENDATIONS
-- ============================================================
CREATE TABLE career_recommendations (
    recommendation_id INT AUTO_INCREMENT PRIMARY KEY,
    student_id INT NOT NULL,
    career_id INT NOT NULL,
    suitability_score DECIMAL(5,2),
    explanation TEXT,
    recommended_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (student_id) REFERENCES students(student_id)
        ON DELETE CASCADE,
    FOREIGN KEY (career_id) REFERENCES careers(career_id)
        ON DELETE CASCADE
);

-- ============================================================
-- 17. SKILL GAPS
-- ============================================================
CREATE TABLE skill_gaps (
    gap_id INT AUTO_INCREMENT PRIMARY KEY,
    student_id INT NOT NULL,
    career_id INT NOT NULL,
    skill_name VARCHAR(100) NOT NULL,
    current_level INT,
    required_level INT,
    gap_value INT,
    FOREIGN KEY (student_id) REFERENCES students(student_id)
        ON DELETE CASCADE,
    FOREIGN KEY (career_id) REFERENCES careers(career_id)
        ON DELETE CASCADE
);

-- ============================================================
-- 18. ROADMAP STEPS
-- ============================================================
CREATE TABLE roadmap_steps (
    roadmap_id INT AUTO_INCREMENT PRIMARY KEY,
    student_id INT NOT NULL,
    career_id INT,
    step_number INT NOT NULL,
    title VARCHAR(200) NOT NULL,
    description TEXT,
    completed BOOLEAN DEFAULT FALSE,
    FOREIGN KEY (student_id) REFERENCES students(student_id)
        ON DELETE CASCADE,
    FOREIGN KEY (career_id) REFERENCES careers(career_id)
        ON DELETE SET NULL
);

-- ============================================================
-- 19. PROGRESS
-- ============================================================
CREATE TABLE progress (
    progress_id INT AUTO_INCREMENT PRIMARY KEY,
    student_id INT NOT NULL,
    roadmap_id INT,
    completed BOOLEAN DEFAULT FALSE,
    completed_at TIMESTAMP NULL,
    FOREIGN KEY (student_id) REFERENCES students(student_id)
        ON DELETE CASCADE,
    FOREIGN KEY (roadmap_id) REFERENCES roadmap_steps(roadmap_id)
        ON DELETE CASCADE
);

-- ============================================================
-- 20. AI MENTOR CHAT
-- ============================================================
CREATE TABLE mentor_chat (
    message_id INT AUTO_INCREMENT PRIMARY KEY,
    student_id INT NOT NULL,
    sender ENUM('student', 'ai') NOT NULL,
    message TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (student_id) REFERENCES students(student_id)
        ON DELETE CASCADE
);

